{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "rootDir": "client/worker",
    "outDir": "dist/public/worker",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "WebWorker"],
    "types": []
  },
  "include": ["client/worker"]
}
