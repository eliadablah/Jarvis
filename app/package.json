{
  "name": "jarvis-web",
  "version": "0.1.0",
  "private": true,
  "description": "Jarvis's web app: the page I open from my phone and laptop over Tailscale.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "start": "node dist/server.js",
    "dev": "node --watch src/server.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
